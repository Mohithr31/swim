# JOCKY environment configuration
# Generate unique secrets before deployment; never deploy these placeholders as-is.
# API key example generation:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Secret example generation:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JOCKY_API_KEY=REPLACE_WITH_GENERATED_API_KEY
JOCKY_SECRET=REPLACE_WITH_GENERATED_SECRET

# TinyFish Live Threat Intelligence API configuration
# Obtain an API key from https://agent.tinyfish.ai/
TINYFISH_API_KEY=your_tinyfish_api_key_here
