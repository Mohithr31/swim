# Server Network Configuration
JOCKY_PORT=5000
JOCKY_DB=jocky_forensics.db
JOCKY_EVIDENCE_DIR=evidence

# Cryptographic and Session Security Secrets
# Generate a cryptographically secure random key before deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JOCKY_SECRET_KEY=REPLACE_WITH_GENERATED_SESSION_SECRET
JOCKY_API_KEY=REPLACE_WITH_GENERATED_AGENT_API_KEY
JOCKY_SECRET=REPLACE_WITH_GENERATED_SECRET

# TinyFish Live Threat Intelligence Search & Fetch API Configuration
# Obtain an API key from https://agent.tinyfish.ai/ or https://docs.tinyfish.ai/
TINYFISH_API_KEY=your_tinyfish_api_key_here


